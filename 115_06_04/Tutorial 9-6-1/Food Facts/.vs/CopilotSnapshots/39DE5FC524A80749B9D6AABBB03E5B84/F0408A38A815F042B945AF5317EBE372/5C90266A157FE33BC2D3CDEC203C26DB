using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Food_Facts
{
    internal class FoodItem
    {
        private string name;
        private double calories;
        private double fat;
        private double carb;

        public string Name
        {
            get { return name; }
            set { name = value; }
        }

        public double Calories
        {
            get { return calories; }
            set { calories = value; }
        }

        public double Carb
        {
            get { return carb; }
            set { carb = value; }
        }

        public FoodItem()
        {
            this.name = name;
            this.calories = calories;
            this.fat = fat;
            this.carb = carb;
        }
    }
}
