using System;
using System.Collections.Generic;
using System.IO;
using System.Windows.Forms;

namespace WindowsFormsApp1
{
    public partial class Form1 : Form
    {
        // 使用 struct 記錄每一筆摩斯密碼資料（繁體中文註解）
        public struct MorseMapping
        {
            public char Character;   // 字元，例如 'A' 或 ' '（空白）
            public string MorseCode; // 對應的摩斯密碼，例如 ".-" 或 "/"（代表字間分隔）
        }

        // 使用 List 儲存完整摩斯密碼表（嚴格不使用 Dictionary）
        private List<MorseMapping> morseCodeTable = new List<MorseMapping>();

        // 密碼表檔案名稱，程式會從執行目錄讀取此檔案
        private const string TableFileName = "morse_code_table.md";

        public Form1()
        {
            InitializeComponent();
        }

        // 表單載入事件：啟動時讀取摩斯密碼表
        private void Form1_Load(object sender, EventArgs e)
        {
            LoadMorseCodeTable();
        }

        /// <summary>
        /// 讀取外部 morse_code_table.md，並將資料解析後存入 morseCodeTable
        /// - 必須使用 File.OpenText() 與 StreamReader
        /// - 使用 while (!inputFile.EndOfStream) 判斷檔案是否結束
        /// - 解析 Markdown 表格格式（以 | 分欄）
        /// </summary>
        private void LoadMorseCodeTable()
        {
            // 檢查檔案是否存在，若不存在顯示錯誤訊息
            if (!File.Exists(TableFileName))
            {
                MessageBox.Show($"找不到摩斯密碼表檔案：{TableFileName}\n請確認檔案是否已放置於程式執行目錄中。", "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            try
            {
                // 使用 File.OpenText() 開啟檔案，回傳 StreamReader
                using (StreamReader inputFile = File.OpenText(TableFileName))
                {
                    // 使用 !inputFile.EndOfStream 判斷是否還有資料
                    while (!inputFile.EndOfStream)
                    {
                        string line = inputFile.ReadLine();

                        // 忽略空白行、Markdown 標題(#)與表格分隔線(:---)
                        if (string.IsNullOrWhiteSpace(line) || line.StartsWith("#") || line.Contains(":---"))
                            continue;

                        // 以豎線拆分欄位，Markdown 表格每兩欄為一組 (Character | Code)
                        string[] parts = line.Split('|');
                        for (int i = 1; i < parts.Length - 1; i += 2)
                        {
                            if (i + 1 >= parts.Length) break;

                            string rawCharStr = parts[i].Trim();
                            // 移除 Markdown 的反引號 `
                            string rawCodeStr = parts[i + 1].Trim().Replace("`", "");

                            // 過濾標題列或不完整的欄位
                            if (string.IsNullOrEmpty(rawCharStr) || string.IsNullOrEmpty(rawCodeStr) ||
                                rawCharStr.Equals("Character", StringComparison.OrdinalIgnoreCase) || rawCharStr.Equals("Code", StringComparison.OrdinalIgnoreCase))
                                continue;

                            // 解析檔案內的字元表示（處理像 space/comma/period 等特殊文字）
                            char targetChar = ParseSpecialCharacter(rawCharStr);

                            // 將檔案中表示空格的 *space* 轉為程式內使用的 "/"
                            string code = NormalizeCode(rawCodeStr);

                            // 將資料封裝到 struct 並加入 List
                            morseCodeTable.Add(new MorseMapping { Character = targetChar, MorseCode = code });
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                // 若讀檔或解析發生例外，顯示錯誤訊息
                MessageBox.Show($"讀取檔案時發生錯誤：{ex.Message}", "系統錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        /// <summary>
        /// 將 raw 字串（像是 "space"、"comma"）轉為實際字元
        /// 使用小型對照表避免大量 if/switch，仍符合題目限制（List 用於查詢）
        /// </summary>
        /// <param name="raw">來源字串</param>
        /// <returns>對應的字元（若非特殊字串則取第一個字元並轉大寫）</returns>
        private char ParseSpecialCharacter(string raw)
        {
            // 小型靜態對照表（大小寫忽略）
            var specials = new Dictionary<string, char>(StringComparer.OrdinalIgnoreCase)
            {
                { "space", ' ' },
                { "comma", ',' },
                { "period", '.' }
            };

            if (specials.TryGetValue(raw, out char ch))
                return ch;

            // 預設取第一個字並轉大寫（處理字母與數字）
            return raw.ToUpper()[0];
        }

        /// <summary>
        /// 正規化密碼欄位的表示
        /// - 若檔案使用 *space* 表示空白，這裡轉為 "/" 來代表字間分隔
        /// </summary>
        private string NormalizeCode(string rawCode)
        {
            if (string.Equals(rawCode, "*space*", StringComparison.OrdinalIgnoreCase))
                return "/"; // 使用斜線代表字間分隔（或您指定的符號）

            return rawCode;
        }

        /// <summary>
        /// 轉換按鈕事件：將 textBox1 的文字逐字轉為摩斯密碼
        /// - 使用 List 尋找對應（不使用大量 if/switch）
        /// - 轉換結果顯示於 textBox2，逐字對照顯示於 listBox1
        /// - 空白字元在 listBox1 顯示為「空白」，對應密碼顯示為 "/"
        /// </summary>
        private void btnConvert_Click(object sender, EventArgs e)
        {
            // 清空先前結果
            textBox2.Clear();
            listBox1.Items.Clear();

            string inputText = textBox1.Text;
            if (string.IsNullOrEmpty(inputText)) return;

            var totalMorse = new List<string>();

            // 逐字處理輸入字串
            foreach (char rawChar in inputText)
            {
                // 小寫轉為大寫以便比對（檔案表是大寫或特殊字元）
                char searchChar = char.ToUpper(rawChar);

                // 使用 List.Find 找到對應的 mapping（不使用大量 if/switch）
                var mapping = morseCodeTable.Find(m => m.Character == searchChar);

                // 若找到對應的 MorseCode，則加入輸出
                if (!string.IsNullOrEmpty(mapping.MorseCode))
                {
                    totalMorse.Add(mapping.MorseCode);

                    // 空白顯示為中文「空白」；其他則顯示該字元
                    string displayChar = (searchChar == ' ') ? "空白" : searchChar.ToString();
                    listBox1.Items.Add($"{displayChar}\t{mapping.MorseCode}");
                }
                // 若找不到則依需求忽略該字元（不加入結果）
            }

            // 將完整摩斯密碼以空格分隔顯示於 textBox2
            textBox2.Text = string.Join(" ", totalMorse);
        }

        /// <summary>
        /// 清除按鈕事件：清空所有欄位並將焦點放回輸入框
        /// </summary>
        private void btnClear_Click(object sender, EventArgs e)
        {
            textBox1.Clear();
            textBox2.Clear();
            listBox1.Items.Clear();
            textBox1.Focus();
        }
    }
}
